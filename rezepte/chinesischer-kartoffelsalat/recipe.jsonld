{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Chinesischer Kartoffelsalat (vegan)",
  "author": {
    "@type": "Person",
    "name": "jingche"
  },
  "description": "Knackige Kartoffelstreifen mit Chili-Knoblauch-Oil",
  "recipeYield": "2 Portionen",
  "recipeIngredient": [
    "2 Stück festkochende Kartoffeln (ca. (geschätzt aus Video))",
    "rote Peperoni/Paprika (1 Streifen/Wand für die Farbe, ca. (geschätzt aus Video))",
    "grüne Peperoni/Paprika (1 Streifen/Wand für die Farbe, ca. (geschätzt aus Video))",
    "Frühlingszwiebeln (nach Belieben, zum Bestreuen)",
    "1–2 Zehen Knoblauch (ca. (geschätzt aus Video), gehackt)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Kartoffeln schälen, seitlich flach anschneiden, so dünn wie möglich in Scheiben und dann in feine Streifen schneiden."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Streifen in kaltes Wasser legen, ca. 15 Min. einweichen, Wasser 2–3× wechseln (wäscht Stärke aus, Streifen werden fester)."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Peperoni entkernen, weisse Teile entfernen, ganz fein julienne schneiden und zu den Kartoffeln geben."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Wasser im Wok aufkochen, Streifen ca. 30–40 Sek. blanchieren."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Sofort in Eiswasser abschrecken (bleibt knackig), gut abtropfen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Mit Salz, Zucker und optional MSG mischen, dann Reisessig, Chiliöl und Sesamöl dazugeben und vermengen."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Einige Minuten marinieren lassen."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Anrichten: gehackten Knoblauch, getrocknete Chilis, Chilipulver/-flocken, Sesam und Frühlingszwiebeln obenauf streuen."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Neutrales Öl stark erhitzen und über die Aromaten giessen (kurz aufschäumen lassen)."
    },
    {
      "@type": "HowToStep",
      "position": 10,
      "text": "Gut durchmischen und sofort servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/chinesischer-kartoffelsalat/",
  "prepTime": "PT25M",
  "cookTime": "PT5M",
  "totalTime": "PT35M"
}