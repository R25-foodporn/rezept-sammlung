{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Spaghetti aglio e olio – Vorrat",
  "author": {
    "@type": "Person",
    "name": "FOODBOOM"
  },
  "description": "Knoblauch und Peperoncino in Olivenöl, cremig gebunden mit Pastawasser",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "250 g Spaghetti",
    "60 ml Olivenöl (plus optional ein Schuss zum Schluss)",
    "Salz (Pastawasser gut salzen; Menge unklar)",
    "Grobes Meersalz (zum Nachsalzen; Menge unklar)",
    "Pastawasser (nach und nach; Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Spaghetti in gut gesalzenem Wasser kochen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Knoblauch dünn schneiden, mit einem ordentlichen Schluck Olivenöl und dem Peperoncino in einer Pfanne ganz langsam braten. Für Kinder den Peperoncino weglassen."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Wenn die Spaghetti noch 3 Minuten brauchen, direkt in die Pfanne geben und Pastawasser dazugiessen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Durchschwenken und nach und nach etwas Pastawasser zugeben, bis die Stärke Öl und Flüssigkeit cremig bindet. Nach Wunsch noch einen Schuss Öl."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Petersilie unterheben, mit grobem Meersalz nachsalzen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/spaghetti-aglio-e-olio/vorrat/",
  "totalTime": "PT10M"
}