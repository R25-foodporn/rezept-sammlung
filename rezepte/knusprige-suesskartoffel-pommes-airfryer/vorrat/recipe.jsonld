{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Knusprige Süsskartoffel-Pommes – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Frank's Fit Kitchen"
  },
  "description": "Aus der Heissluftfritteuse mit Stärke und Rauchpaprika, dazu leichte Mayo",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "1 TL Speisestärke (Kartoffel- oder Maisstärke)",
    "1 TL Geräuchertes Paprikapulver",
    "1 EL Olivenöl",
    "1 EL Senf (Mayo)",
    "Salz und Pfeffer (Pommes und Mayo; Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Süsskartoffel in Sticks schneiden, mit Stärke, Paprika, Salz, Pfeffer und Öl vermengen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "In der Heissluftfritteuse bei 200 °C ca. 15–20 Minuten garen, zwischendurch schütteln."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Währenddessen für die Mayo Eier, Joghurt oder Hüttenkäse, Senf, Zitronensaft, Salz und Pfeffer mixen. Für kleine Kinder nur mit hart gekochten Eiern oder ohne Ei."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Pommes mit der Mayo anrichten."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/knusprige-suesskartoffel-pommes-airfryer/vorrat/",
  "cookTime": "PT15–20 Min.M",
  "totalTime": "PT< 20 Min.M"
}