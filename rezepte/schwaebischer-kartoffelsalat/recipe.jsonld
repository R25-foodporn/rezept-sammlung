{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Schwäbischer Kartoffelsalat",
  "author": {
    "@type": "Person",
    "name": "KELADAM"
  },
  "description": "Mit Brühe und Essig, ohne Mayo (Team Süd)",
  "recipeYield": "6 Portionen",
  "recipeIngredient": [
    "1500 g festkochende Kartoffeln",
    "1 Stück Zwiebel"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Kartoffeln waschen und in Salzwasser gar kochen. Abgiessen, etwas ausdampfen, schälen und noch warm in Scheiben schneiden."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Zwiebel fein würfeln. Brühe mit Weissweinessig, Lorbeerblatt, Senf, Prise Zucker, Salz, Pfeffer und Muskat erhitzen (nicht stark kochen lassen)."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Warme Kartoffelscheiben mit den Zwiebelwürfeln mischen und mit der heissen Brühe-Essig-Marinade übergriessen. Sanft unterheben."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Rapsöl nach Belieben darunterheben. Mindestens 30–60 Min. durchziehen lassen; ggf. nachwürzen und bei Bedarf etwas Brühe nachgiessen, falls der Salat zu trocken wirkt."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Lorbeerblatt vor dem Servieren entfernen. Lauwarm oder Zimmertemperatur servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/schwaebischer-kartoffelsalat/",
  "prepTime": "PT25M",
  "cookTime": "PT30M",
  "totalTime": "PT70M"
}