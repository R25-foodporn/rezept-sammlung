{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Kartoffel-Spinat-Quiche ohne Teig",
  "author": {
    "@type": "Person",
    "name": "Gymperium_"
  },
  "description": "Gekochte Kartoffeln als Boden, Spinat, Eier mit Hüttenkäse und Käse – im Ofen gebacken",
  "recipeYield": "1 Portionen",
  "recipeIngredient": [
    "200 g Kartoffeln (gekocht; im Video mit Schale; Sorte unklar)",
    "80 g Tiefkühl-Spinat (aufgetaut)",
    "2 Stück Eier (ca. 120 g)",
    "100 g Hüttenkäse light",
    "30 g Geriebener Käse light (Sorte unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Kartoffeln weich kochen (Kochzeit unklar)."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Kartoffeln in eine ofenfeste Form legen (Grösse unklar) und mit dem Boden eines Glases flachdrücken."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Aufgetauten Spinat auf den Kartoffeln verteilen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Eier, Hüttenkäse, italienische Kräuter und Chiliflocken darübergeben und direkt in der Form mit einer Gabel verquirlen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Geriebenen Käse darüberstreuen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Bei 180 °C 20–25 Minuten backen (Ober-/Unterhitze oder Umluft unklar). Im Video zum Schluss mit Petersilie bestreut."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/kartoffel-spinat-quiche-ohne-teig/"
}