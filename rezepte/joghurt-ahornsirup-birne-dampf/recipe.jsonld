{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Selbstgemachter Joghurt mit Ahornsirup, Birne und Haselnüssen",
  "author": {
    "@type": "Person",
    "name": "Siemens Cooking inspirations CS858GRB7B, S. 150"
  },
  "description": "Siemens Dampfbackofen · Steffi (CS756G1B1) · Teig gehen lassen 40 °C",
  "recipeYield": "4 Portionen",
  "recipeIngredient": [
    "1 l Vollmilch",
    "100 g Joghurt mit lebenden Kulturen (gleicher Fettgehalt wie die Milch)",
    "0.5 Stück weiche Birne (pro Portion)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Vollmilch in einer Pfanne auf 90 °C erhitzen, nicht kochen lassen. Auf 38–45 °C abkühlen lassen, mit Küchenthermometer messen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Milch und Joghurt mischen, in gut ausgespülte Becher füllen. Mit hitzebeständiger Folie abdecken und in den grossen gelochten Dampfgarbehälter stellen, Ebene 1."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Im Garraum fermentieren: Programm «Teig gehen lassen» 40 °C, 5 Std."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Pro Portion 200 g Joghurt mit ½ Birne, 1–2 EL Ahornsirup und 1 EL gemahlenen Haselnüssen servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/joghurt-ahornsirup-birne-dampf/",
  "cookTime": "PT300M"
}