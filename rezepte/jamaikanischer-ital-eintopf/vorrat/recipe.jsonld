{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Jamaikanischer Ital-Eintopf – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Healthier Steps"
  },
  "description": "Ital Stew – Kartoffeln und Kidneybohnen in Kokosmilch, vegan",
  "recipeYield": "4 Portionen",
  "recipeIngredient": [
    "1 EL Kokosöl",
    "0.5 TL getrockneter Thymian",
    "1 TL Italian Seasoning (italienische Kräutermischung)",
    "6 Stück getrocknete Pimentbeeren (Allspice)",
    "2 Stück Lorbeerblätter",
    "60 ml Bragg’s Liquid Aminos oder Sojasauce (Quelle: ¼ cup)",
    "1 EL Tomatenmark",
    "1 Dose Kokosmilch, Dose (typisch 400 ml; Quelle: 1 can)",
    "960 ml Wasser (Quelle: 4 cups)",
    "0.5 TL Salz (nach Geschmack; Autorin: ½ TL)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Öl in grossem Topf mittelhoch erhitzen. Zwiebel ca. 3 Min. weich dünsten."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Knoblauch, Frühlingszwiebel, Sellerie, Thymian, Italian Seasoning, Piment und Lorbeer 1 Min. mitrösten bis duftend."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Liquid Aminos/Sojasauce, Tomatenmark, Kartoffeln, Karotten und Kohl einrühren, ca. 1 Min. mitbraten."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Kokosmilch, Wasser, Kidneybohnen und ganze Scotch Bonnet zugeben (optional Soy Curls laut Quelle). Aufkochen, dann köcheln."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Ca. 30 Min. köcheln bis Eintopf dick und Gemüse gar. Mit Salz abschmecken. Peperoni vor dem Servieren entfernen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/jamaikanischer-ital-eintopf/vorrat/",
  "prepTime": "PT20M",
  "cookTime": "PT35M",
  "totalTime": "PT55M"
}