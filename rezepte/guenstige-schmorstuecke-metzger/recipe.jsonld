{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "7 günstige Schmorstücke",
  "author": {
    "@type": "Person",
    "name": "Metzgermeister Helmut"
  },
  "description": "Nacken, Schulter, Bauch, Backe, Kasseler, Beinscheibe, Suppenfleisch",
  "recipeYield": "4 Portionen",
  "recipeIngredient": [
    "1,5 kg Schweinenacken am Stück (Hauptrezept, für 4 Personen mit Resten)",
    "Schweineschulter (mit Schwarte für Kruste; Menge unklar)",
    "Schweinebauch am Stück (mit Schwarte; Menge unklar)",
    "Schweinebacken, pariert (an der Theke fragen; Menge unklar)",
    "Kasseler (Braten oder Koteletts; Menge unklar)",
    "Rinderbeinscheiben (Menge unklar)",
    "1 kg Suppenfleisch vom Rind (Brust oder Bugblatt)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Schweinenacken: 1,5 kg rundum salzen und pfeffern, in schwerer Pfanne kräftig anbraten, mit etwas Brühe im Bräter bei 160 °C Ober-/Unterhitze ca. 2½ Std. garen, nach halber Zeit wenden. Nicht nach 1½ Std. herausnehmen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Schweineschulter: mit Salz, Pfeffer, grob geschnittener Zwiebel, Möhren und ½ l Brühe bei 150 °C 3–3½ Std. Mit Schwarte die letzte halbe Stunde ohne Deckel bei 220 °C."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Schweinebauch: Schwarte rautenförmig einschneiden, nicht ins Fleisch, Salz und optional Kümmel hinein. Schwarte nach unten in etwas Wasser bei 160 °C gut 1 Std., wenden, Wasser bis auf einen Finger breit abgiessen, weitere 1½ Std., die letzten 20 Min. mit starker Oberhitze."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Schweinebacke: kräftig anbraten, mit Zwiebel, etwas Tomatenmark, Rotwein oder dunklem Bier und Brühe ablöschen, bei 160 °C 2–2½ Std. geschlossen schmoren."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Kasseler: ist schon gepökelt. Braten bei 140 °C höchstens 40–50 Min. Koteletts nur in 80 °C heissem Wasser 10 Min. ziehen lassen, nicht kochen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Rinderbeinscheibe: beidseitig kräftig anbraten, Zwiebel, Möhre, Sellerie und Tomatenmark dazu, mit Rotwein ablöschen, bei 160 °C 3 Std. geschlossen schmoren. Alternativ kalt in Wasser aufsetzen für Brühe."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Suppenfleisch: 1 kg für kräftige Brühe kalt aufsetzen, für saftigeres Fleisch in siedendes Wasser legen. 2½–3 Std. ganz leicht sieden, nie sprudelnd kochen."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Sicherheit: Schweinefleisch in der Mitte mindestens 70 °C, 2 Min. lang. Bei Unsicherheit Einstichthermometer verwenden."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/guenstige-schmorstuecke-metzger/"
}