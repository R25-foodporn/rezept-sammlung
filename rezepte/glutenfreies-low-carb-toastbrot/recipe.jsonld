{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Glutenfreies Low-Carb-Toastbrot",
  "author": {
    "@type": "Person",
    "name": "Frank's Fit Kitchen"
  },
  "description": "Aus Mandelmus, Eiern und Crème fraîche – im Mixer verrührt und in der kleinen Kastenform gebacken",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "4 Stück Eier",
    "200 g Crème fraîche (im Ton nennt er 100 g Crème fraîche oder saure Sahne)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Backofen auf ca. 160–170 °C Ober-/Unterhitze vorheizen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Mandelmus, Eier, Crème fraîche, Backpulver und Salz in den Mixer geben und kurz durchmixen. Der Teig ist flüssig und cremig."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Eine kleine Kastenform einfetten (Grösse in cm unklar), mit Backpapier auslegen und das Papier zusätzlich leicht mit Öl bepinseln."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Teig einfüllen und nach Wunsch mit schwarzem und weissem Sesam bestreuen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Backen, bis das Brot durch ist. Backzeit für diese Menge unklar – ca. 40 Min. bei doppelter Menge, laut Creator geschätzt."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Etwas abkühlen lassen, aus der Form lösen und in Scheiben schneiden. Das Brot sackt beim Abkühlen etwas zusammen. Nach Wunsch toasten oder in der Pfanne knusprig braten."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/glutenfreies-low-carb-toastbrot/"
}