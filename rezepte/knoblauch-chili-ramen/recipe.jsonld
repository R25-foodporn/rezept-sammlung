{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Knoblauch-Chili-Ramen",
  "author": {
    "@type": "Person",
    "name": "leilakocht"
  },
  "description": "Cremige Nudeln mit Knoblauch, Chili und Nudelwasser, unter 10 Min.",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "3  Knoblauchzehen (fein gehackt)",
    "1  Rote Bird's-Eye-Chili (nach Geschmack, für Kinder weglassen)",
    "1–2 Stangen Frühlingszwiebeln",
    "1 Handvoll Petersilie",
    "Limette (für 1–2 EL Saft)",
    "Käse in Scheiben (nur im Video, Menge unklar, nicht vegan)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Ramen kochen, Nudelwasser aufheben. Kochzeit unklar."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Öl in einer Pfanne erhitzen, Knoblauch, Chili, Frühlingszwiebeln, Petersilie, Sojasauce, vegane Austernsauce und Brühpulver hineingeben."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Etwas Nudelwasser und nach Wunsch passierte Tomaten dazugeben und leicht eindicken lassen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Nudeln dazugeben und gut vermischen, Limettensaft dazu."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Im Video kommt etwas Käse obendrauf, dann Deckel zu. Achtung: Käse ist nicht vegan, für die vegane Version weglassen oder veganen Käse nehmen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Kinderversion laut Familiennotiz von SecondBrain, nicht aus der Quelle: Chili, Chiliflocken und Gochujang weglassen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/knoblauch-chili-ramen/",
  "totalTime": "PT< 10 Min.M"
}