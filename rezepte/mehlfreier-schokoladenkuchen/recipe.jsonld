{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Mehlfreier Schokoladenkuchen",
  "author": {
    "@type": "Person",
    "name": "Coach Carnivore Cam"
  },
  "description": "Dreistöckig mit Rohkakao, Milchpulver statt Mehl und Mascarpone-Ganache",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "18  Eier (10 ganze Eier und 8 Eigelb)",
    "400 g Butter (geschmolzen, plus etwas für die Formen)",
    "80 g Sauerrahm",
    "400 ml Doppelrahm (Frosting, 300 ml und 100 ml)",
    "250 g Mascarpone (Frosting)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "2 EL Rohkakao und Espressopulver mit kochendem Wasser glatt rühren und ca. 5 Minuten stehen lassen. Butter bei kleiner Hitze schmelzen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "10 Eier und 8 Eigelb dazugeben, dann 12 EL Rohkakao, Milchpulver, Backpulver, Sauerrahm, Vanille, Ahornsirup und Salz. Kurz verrühren."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Die geschmolzene Butter unter Rühren langsam einlaufen lassen, bis der Teig glatt, glänzend und dickflüssig ist."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "3 Formen à ca. 20 cm am Rand buttern, mit Backpapier auslegen, Teig gleichmässig verteilen, am besten abwägen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Bei 175 °C 30 Minuten backen. Heizart unklar."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Frosting: Schokoladenchips über dem Wasserbad schmelzen, etwas Ahornsirup und nach und nach 300 ml Doppelrahm einrühren. Mindestens 1 Stunde bei Raumtemperatur stehen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Böden 15–20 Minuten in den Formen lassen, stürzen, Backpapier entfernen und vollständig auskühlen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Mascarpone mit dem Handmixer auf niedriger Stufe unter die Ganache rühren, 100 ml Doppelrahm dazugeben, bis das Frosting cremig und standfest ist."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Böden flach schneiden, mit Frosting stapeln und den ganzen Kuchen rustikal einstreichen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/mehlfreier-schokoladenkuchen/",
  "cookTime": "PT30M"
}