{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Hähnchen-Fleischbällchen mit Kräuter-Orzo",
  "author": {
    "@type": "Person",
    "name": "Yarin Danieli"
  },
  "description": "Kräuter-Bällchen aus dem Ofen auf cremigem Lauch-Orzo",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "Hähnchenhack (Menge unklar)",
    "Petersilie (reichlich, gehackt; Menge unklar)",
    "Zwiebel (fein gerieben; nur im Video zu sehen; Menge unklar)",
    "Knoblauch (für Bällchen und Orzo; nur im Video zu sehen; Menge unklar)",
    "Ei (im Video 1 Ei aufgeschlagen; Menge unklar)",
    "Lauch (in feinen Ringen; nur im Video zu sehen; Menge unklar)",
    "Zitrone (für Abrieb; nur im Video zu sehen; Menge unklar)",
    "Spinat (Blätter; nur im Video zu sehen; Menge unklar)",
    "Dill (nur im Video zu sehen; Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Zwiebel fein reiben und Petersilie hacken. Hähnchenhack mit Zwiebel, viel Petersilie, geriebenem Knoblauch, Salz, Paniermehl bzw. Käse, Ei und etwas Olivenöl von Hand vermengen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Bällchen formen und in einer grossen, ofenfesten Pfanne rundum goldbraun anbraten."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Bällchen herausnehmen und im Ofen fertig garen. Temperatur und Zeit unklar."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Währenddessen in derselben Pfanne den Lauch andünsten, Knoblauch dazugeben."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Orzo dazugeben, mit Weisswein ablöschen, Flüssigkeit dazugiessen und unter Rühren cremig garen. Art und Menge der Flüssigkeit sowie Garzeit unklar."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Zitronenabrieb, Spinat, Petersilie und Dill unterheben."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Die Fleischbällchen auf den Orzo setzen und nach Wunsch mit etwas Olivenöl beträufeln."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/haehnchen-fleischbaellchen-kraeuter-orzo/"
}