{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Rindsgeschnetzeltes mit Rösti",
  "author": {
    "@type": "Person",
    "name": "FoodieBootie Rezeptsammlung"
  },
  "description": "Zürcher Art – rahmig und alltagstauglich",
  "recipeYield": "4 Portionen",
  "recipeIngredient": [
    "500 g Rindsgeschnetzeltes",
    "250 g Champignons",
    "2 Stück Zwiebeln",
    "1 Stück Knoblauchzehe",
    "2 dl Vollrahm",
    "1 dl Weisswein trocken",
    "1 Bund Petersilie (fein gehackt)",
    "800 g festkochende Kartoffeln (für Rösti)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Kartoffeln schälen, grob reiben, salzen und ausdrücken. Mit Öl zu goldbraunen Rösti braten (ca. 8–10 Min. pro Seite)."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Fleisch trocken tupfen, salzen und pfeffern. In heisser Butter portionsweise scharf anbraten, beiseitestellen."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Zwiebeln und Champignons in derselben Pfanne anbraten, Knoblauch kurz mitrösten."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Mit Mehl bestäuben, Weisswein ablöschen, Bouillon und Rahm zugeben. Ca. 8 Min. köcheln lassen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Fleisch zurück in die Sauce, 2–3 Min. erwärmen (nicht mehr kochen). Mit Petersilie und Rösti servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/rindsgeschnetzeltes-roesti/",
  "prepTime": "PT20M",
  "cookTime": "PT35M",
  "totalTime": "PT55M"
}