{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Apfel-Zimt-Zupfbrot",
  "author": {
    "@type": "Person",
    "name": "Hensslers Schnelle Nummer"
  },
  "description": "Zimtschnecke trifft Apfelstrudel – gestapelt in der Kastenform",
  "recipeYield": "1 Portionen",
  "recipeIngredient": [
    "1 Pck. süsser Hefeteig aus dem Kühlregal",
    "115 g weiche Butter (15 g für die Äpfel, 100 g für die Zimtbutter)",
    "350 g Äpfel (ca. 2 Stück)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Äpfel schälen, entkernen und fein würfeln. 15 g Butter in einer Pfanne langsam zerlassen, Apfelwürfel darin kurz andünsten. Vanillezucker und ½ EL Zimt zugeben, Speisestärke einrühren und kurz weitergaren, bis die Masse leicht gebunden ist. Abkühlen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "100 g weiche Butter mit braunem Zucker und 2½ EL Zimt zu einer gleichmässigen Zimt-Zucker-Butter verrühren."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Hefeteig auf leicht bemehlter Fläche ausrollen, gleichmässig mit der Zimtbutter bestreichen und die abgekühlten Äpfel darauf verteilen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Teig in gleich grosse Quadrate schneiden, die in die Kastenform passen. Form einfetten oder mit Backpapier auslegen. Quadrate aufeinanderstapeln und hochkant nebeneinander in die Form setzen. Zugedeckt ca. 30 Min. gehen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Backofen auf 180 °C Umluft vorheizen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Ca. 45 Min. backen, bis das Zupfbrot goldbraun und karamellisiert ist. Am besten warm servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/apfel-zimt-zupfbrot/",
  "cookTime": "PT45M"
}