{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Kichererbsen-Bratlinge",
  "author": {
    "@type": "Person",
    "name": "The Food Explorer"
  },
  "description": "Mit Zwiebel, Peperoni und Petersilie, dazu Joghurt-Gurken-Sauce",
  "recipeYield": "2 Portionen",
  "recipeIngredient": [
    "2  Eier",
    "70 g Zwiebel (gehackt)",
    "100 g Peperoni (rot, gewürfelt)",
    "3 Zehen Knoblauch (ca. 15 g; 2 für die Bratlinge, 1 für die Sauce)",
    "10 g Petersilie (frisch, gehackt)",
    "120 g Griechischer Joghurt (Sauce)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Eier verquirlen, abgetropfte Kichererbsen dazugeben und mit dem Stabmixer grob pürieren."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Zwiebel hacken und in Olivenöl andünsten, Peperoni dazugeben, mit Salz, Pfeffer und Paprika würzen und 7 Minuten braten."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Gemüse zur Kichererbsenmasse geben, Petersilie, Salz, Pfeffer, Kräuter der Provence und 2 gepresste Knoblauchzehen untermischen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Paniermehl unterrühren, mit nassen Händen Bratlinge formen. Anzahl unklar."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "In Olivenöl pro Seite 5 Minuten braten."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Für die Sauce Joghurt mit geriebener Essiggurke, 1 gepressten Knoblauchzehe, Salz und Pfeffer verrühren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/kichererbsen-bratlinge/"
}