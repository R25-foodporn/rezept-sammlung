{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Bienenstich ohne Reue – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Frank's Fit Kitchen"
  },
  "description": "Glutenfrei in Mealprep-Boxen: Mandelboden, Joghurt-Vanille-Creme, Honig-Mandelkruste",
  "recipeYield": "3 Portionen",
  "recipeIngredient": [
    "150 g Apfelmark, ungesüsst (für den Boden)",
    "200 g Mandeln, gemahlen (für den Boden)",
    "1 TL Backpulver (für den Boden)",
    "1 Prise Salz (für den Boden, dazu 1 kleine Prise für die Kruste)",
    "8–10 g Flohsamenschalen (für die Creme)",
    "1 TL Vanille (für die Creme, im Video Mark einer Vanilleschote; optional 1 TL oder etwas Zimt für den Boden)",
    "15–25 g Honig (für die Creme, je nach Süsse)",
    "20–25 g Honig (für die Kruste)",
    "10–15 g Honig (optional für den Boden)",
    "60 g Mandeln, gehobelt (für die Kruste)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Backofen vorheizen. Temperatur unklar, sie steht weder in der Beschreibung noch wird sie im Video genannt."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Boden: Apfelmark mit Salz und Backpulver in eine Schüssel geben, die Eier unterrühren, dann die gemahlenen Mandeln dazugeben und zu einem Teig verrühren. Nach Wunsch Vanille oder Zimt, Honig oder etwas Zitronenabrieb dazugeben."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Teig in ofenfeste Mealprep-Boxen verteilen und glatt streichen, Dicke nach Wunsch; er geht noch etwas auf. Alternativ in einem Kuchenring backen. Im Video bleibt der Boden in der Box, weil er sich ohne Gluten schlecht löst."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Kruste: Gehobelte Mandeln mit Honig und einer kleinen Prise Salz vermengen und auf einem Backblech verteilen, am besten auf Backpapier, sonst klebt es fest."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Boden ca. 15 Min. backen, laut Video, bis er durch und fluffig ist. Die Mandeln gleichzeitig mitbacken; sie sind schneller fertig, also im Auge behalten, damit sie nicht verbrennen. Backzeit der Mandeln unklar."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Creme: Joghurt mit Honig und Vanille glatt rühren. Die Flohsamenschalen erst zum Schluss mit dem Schneebesen einrühren, sie binden sofort; nicht mehr als angegeben, sonst wird die Creme zu fest. Einige Minuten quellen lassen. Für mehr Cremigkeit etwas Joghurt nachrühren."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Die Mandeln abkühlen lassen, damit sie knusprig werden, dann vom Blech lösen und zerbröseln."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Den Boden am besten zuerst abkühlen lassen. Creme in den Boxen auf dem Boden verteilen, mit den Honigmandeln bestreuen und kalt stellen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/bienenstich-ohne-reue-glutenfrei/vorrat/"
}