{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Karotten-Tarte-Tatin",
  "author": {
    "@type": "Person",
    "name": "Capucine Emily"
  },
  "description": "Gestürzte Tarte mit Parmesan, Balsamico, Honig und Blätterteig",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "700–800 g Karotten (geschätzt, nicht aus der Quelle)",
    "1  Blätterteig, rund (ca. 32 cm, geschätzt, nicht aus der Quelle)",
    "40–50 g Parmesan (gerieben, geschätzt, nicht aus der Quelle)",
    "Butter (Menge unklar)",
    "Kräuter zum Garnieren (nur im Video, Sorte und Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "abgeleitet aus dem Video: Karotten schälen, längs halbieren und in Stücke schneiden."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "abgeleitet aus dem Video: Olivenöl und Butter in einer Pfanne erhitzen, Karotten darin anbraten und würzen, bis sie weich und gebräunt sind. Zeit und Hitze unklar; SecondBrain schätzt ca. 8–10 Min. zugedeckt mit etwas Wasser, geschätzt, nicht aus der Quelle."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "abgeleitet aus dem Video: Eine runde Form mit zerknülltem Backpapier auslegen. Parmesan darauf reiben, Balsamico und Honig darüberträufeln."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "abgeleitet aus dem Video: Die Karotten dicht auf die Parmesanschicht legen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "abgeleitet aus dem Video: Blätterteig darüberlegen und den Rand nach innen stecken."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Backen, bis der Teig goldbraun ist. Temperatur und Zeit unklar; SecondBrain schätzt ca. 200 °C, 25–30 Min., geschätzt, nicht aus der Quelle."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "abgeleitet aus dem Video: Auf einen Teller stürzen, Backpapier abziehen, mit Parmesan und Kräutern garnieren. Die Quelle serviert Bohnensalat-Reste dazu."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Familiennotiz von SecondBrain, nicht aus der Quelle: Für den 1-Jährigen Karotten klein schneiden und wenig Parmesan nehmen; unter 12 Monaten keinen Honig."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/karotten-tarte-tatin/"
}