  "description": "Räucherlachs, Avocado und Reis in der Eiswürfelform gepresst",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "Räucherlachs (Menge unklar, oder Protein nach Wahl)",
    "Avocado (Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "abgeleitet aus dem Video: Eiswürfelform mit Frischhaltefolie auslegen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "abgeleitet aus dem Video: Räucherlachs in Stücken in die Mulden legen, dann Avocado darauf."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "abgeleitet aus dem Video: Reis darauf verteilen und mit einem Löffel fest andrücken."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "abgeleitet aus dem Video: Nori-Stücke obendrauf legen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "abgeleitet aus dem Video: Ein Brett auflegen, alles umdrehen und die Form samt Folie abheben."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "abgeleitet aus dem Video: Mit Spicy Mayo und Sesam toppen, Coconut Aminos oder Sojasauce zum Dippen dazu."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Kleinkind-Version laut Familiennotiz von SecondBrain, nicht aus der Quelle: Räucherlachs weglassen."
    }
  ],
