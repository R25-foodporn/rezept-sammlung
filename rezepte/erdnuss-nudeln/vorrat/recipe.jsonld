  "name": "Erdnuss-Nudeln – Vorrat",
  "author": {
    "@type": "Person",
    "name": "howiener"
  },
  "description": "Sauce aus Erdnussbutter, Chiliöl, Sojasauce und Zitrone, mit Nudeln vermengt",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "Nudeln (Sorte und Menge unklar; im Video dicke Nudeln aus dem China-Laden, im Original Bio-Nudeln)",
    "Erdnussbutter (Menge unklar, der Creator würzt nach Gefühl)",
    "Erdnüsse (gehackt; Menge unklar, der Creator würzt nach Gefühl)",
    "Chiliöl (Menge unklar, der Creator würzt nach Gefühl)",
    "Sojasauce (Menge unklar, der Creator würzt nach Gefühl)",
    "Sesam (Menge unklar, der Creator würzt nach Gefühl)",
    "Wasser (heiss, für die Sauce; Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Nudeln kochen. Kochzeit unklar, das Kochen wird im Video nicht gezeigt."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Knoblauch, Erdnussbutter, gehackte Erdnüsse, Chiliöl, Sojasauce, Zitronensaft und Sesam in eine grosse Pfanne geben. Im Original wird alles auf einem Teller angerührt; die Pfanne steht im Video auf der Arbeitsfläche und wird nicht erhitzt."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Heisses Wasser dazugeben und alles glatt rühren. Mengen unklar, der Creator würzt nach Gefühl."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Die gekochten Nudeln dazugeben und gründlich mit der Sauce vermengen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/erdnuss-nudeln/vorrat/"
