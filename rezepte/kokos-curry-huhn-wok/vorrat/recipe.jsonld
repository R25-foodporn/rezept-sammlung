{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Kokos-Curry-Huhn aus dem Wok – Vorrat",
  "author": {
    "@type": "Person",
    "name": "jingche"
  },
  "description": "Velvetiertes Poulet mit Gemüse in Kokos-Curry, ohne Sojasauce",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "Kartoffelstärke (etwas; Menge unklar)",
    "Salz (etwas; Menge unklar)",
    "Neutrales Öl (Menge unklar)",
    "Kokosöl (Menge unklar)",
    "ca. 2–3 EL Currypaste (geschätzt, nicht aus der Quelle; Sorte unklar)",
    "ca. 2 Dosen Kokosmilch (geschätzt, nicht aus der Quelle)",
    "Fischsauce (zum Abschmecken)",
    "Palmzucker (oder brauner bzw. weisser Zucker; Menge unklar)",
    "Reis (zum Servieren; Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Poulet mit 2 Eiweiss kurz durchkneten, etwas Salz und Kartoffelstärke unterheben."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Kaltes Öl in den heissen Wok, Poulet hineingeben, nur ganz kurz garen und abtropfen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Im selben Wok Zwiebel kurz anrösten, Peperoni, Pilze und Pak-Choi-Stiele mit etwas Salz dazu, dann zum Poulet geben."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Kokosöl, Zitronengras, Chili und Currypaste kurz anrösten. Für Kinder Chili weglassen und separat servieren."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Kokosmilch dazugeben; wenn es blubbert, Poulet und Gemüse zurück in den Wok, durchschwenken."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Korianderstiele, Limettenblätter, mehr Kokosmilch, kleine Flamme, Thai-Basilikum, Pak-Choi-Blätter und Sprossen dazu, schwenken."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Mit Fischsauce und Palmzucker abschmecken, Korianderblätter darüber, mit Reis servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/kokos-curry-huhn-wok/vorrat/"
}