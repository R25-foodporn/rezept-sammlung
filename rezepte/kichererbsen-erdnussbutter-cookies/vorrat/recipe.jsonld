{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Kichererbsen-Erdnussbutter-Cookies – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Stefan Bodegrajac"
  },
  "description": "Mit Schokostückchen, ohne Mehl: mixen, unterheben, backen",
  "recipeYield": "12 Portionen",
  "recipeIngredient": [
    "40 g Erdnussbutter, fein",
    "20 g Honig (unter 1 Jahr: Ahornsirup, siehe Familiennotiz)",
    "1 TL Vanilleextrakt",
    "1 TL Backpulver",
    "Backpapier"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Ofen auf 180 °C vorheizen, ein Blech mit Backpapier auslegen. Heizart unklar."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Kichererbsen, Erdnussbutter, Honig, Vanille und Backpulver in einen Mixer oder Food Processor geben."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Zu einem glatten, dicken Cookie-Teig mixen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Schokostückchen unterheben."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Masse in 12 Cookies teilen, aufs Blech setzen, formen und leicht flach drücken."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "15–20 Min. backen, bis sie oben leicht golden sind."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Abkühlen lassen, beim Abkühlen werden sie noch etwas fester."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Familiennotiz von SecondBrain, nicht aus der Quelle: Für Kinder unter 1 Jahr den Honig durch Ahornsirup ersetzen."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/kichererbsen-erdnussbutter-cookies/vorrat/",
  "cookTime": "PT15–20 Min.M"
}