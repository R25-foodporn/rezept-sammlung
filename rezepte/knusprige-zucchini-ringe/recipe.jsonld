{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Knusprige Zucchini-Ringe",
  "author": {
    "@type": "Person",
    "name": "Ana Negoita / Essen Paradies"
  },
  "description": "Ofen-Ringe mit Parmesan und cremigem Zucchini-Dip (Joghurt-Tahini)",
  "recipeYield": "2 Portionen",
  "recipeIngredient": [
    "2 Stück Zucchini, mittelgross (dicke Scheiben, Mittelstück für den Dip ausstechen)",
    "2 EL Parmesan, gerieben (plus etwas extra zum Bestreuen nach dem Backen)",
    "2 EL natureller Joghurt (für den Dip)",
    "1 Stück Knoblauchzehe (für den Dip)",
    "2 EL frische Petersilie (gehackt; für den Dip)",
    "0.5 Stück Zitrone (Saft davon; für den Dip)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Ofen auf 200 °C (Ober-/Unterhitze) vorheizen. Zucchini in dicke Scheiben schneiden; mit Flaschenverschluss oder Ausstecher die Kerne/Mittelstücke entfernen → Ringe. Mittelstücke für den Dip beiseitestellen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Ringe in einer grossen Schüssel mit 3 EL Olivenöl, Speisestärke, Paniermehl, 2 EL Parmesan und den Ring-Gewürzen (Salz, Knoblauchpulver, Paprika, Oregano, Zwiebelpulver, Pfeffer) gleichmässig wenden."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Ringe in einer Lage auf ein mit Backpapier belegtes Blech legen. 20–25 Min. backen bis goldbraun und knusprig. Sofort mit etwas extra Parmesan bestreuen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Dip: Mittelstücke in 1 EL Olivenöl weich braten. Mit Joghurt, Tahini, Zitronensaft, Knoblauch, Petersilie und Dip-Gewürzen (Salz, Paprika, Pfeffer, Chiliflocken) im Mixer/Foodprocessor cremig pürieren."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Warme Zucchini-Ringe mit dem cremigen Dip servieren."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/knusprige-zucchini-ringe/",
  "prepTime": "PT15M",
  "cookTime": "PT25M",
  "totalTime": "PT40M"
}