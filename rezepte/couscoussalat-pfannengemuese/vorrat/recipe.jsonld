{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Couscoussalat mit Pfannengemüse – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Salatschwester"
  },
  "description": "Vegan mit Kichererbsen – mediterran und mealprep-tauglich",
  "recipeYield": "6 Portionen",
  "recipeIngredient": [
    "200 g Couscous (nach Herstellerangabe garen)",
    "4 EL Olivenöl (fürs Dressing)",
    "1 TL Ketchup (alternativ Tomatenmark)",
    "1 EL Agavendicksaft",
    "1 Prise Paprikapulver",
    "1 TL Salz",
    "Pfeffer (nach Geschmack)",
    "1 EL Öl, z. B. Rapsöl (fürs Pfannengemüse)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Couscous nach Herstellerempfehlung zubereiten und etwas abkühlen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Dressing: Knoblauch schälen und fein pressen. Mit Olivenöl, Zitronensaft, Ketchup (oder Tomatenmark), Agavendicksaft, Paprikapulver, Salz und Pfeffer zu einem würzigen Dressing verrühren und abschmecken."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Pfannengemüse: Zucchini und Paprika waschen; Paprika entkernen und würfeln, Zucchini-Enden entfernen und würfeln. Zwiebel schälen und fein hacken oder in Ringe schneiden."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "1 EL Öl in einer Pfanne erhitzen und das Gemüse max. 10 Min. bei mittlerer Hitze andünsten (nicht braten)."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Gurke waschen, nach Bedarf schälen und würfeln. Kichererbsen abspülen und gut abtropfen lassen. Petersilie waschen, trockenschütteln und fein hacken."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Couscous, Kichererbsen, Gurke, Pfannengemüse und Dressing in einer grossen Schüssel vermengen. Mit Petersilie toppen. Lauwarmen oder kalt geniessen; bis zum Verzehr im Kühlschrank lagern."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/couscoussalat-pfannengemuese/vorrat/",
  "prepTime": "PT25M",
  "cookTime": "PT20M",
  "totalTime": "PT45M"
}