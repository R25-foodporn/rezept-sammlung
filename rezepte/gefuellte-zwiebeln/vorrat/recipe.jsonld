{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Gefüllte Zwiebeln – Vorrat",
  "author": {
    "@type": "Person",
    "name": "Rimaluu"
  },
  "description": "Mit Reis, Kräutern, Minze und Hackfleisch oder Baumnüssen in Tomatensauce",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "100 g Reis (ca. ½ Tasse, Sorte unklar)",
    "50 g Baumnüsse (gehackt; für die vegetarische Variante Menge unklar)",
    "3 EL Tomatenmark (1½ EL für die Füllung, 1½ EL für die Sauce; ohne Fleisch ½ EL mehr)",
    "4–6 EL Olivenöl (2–4 EL für die Füllung, 2 EL für die Sauce)",
    "2 Tassen Wasser (für die Sauce)",
    "Paprika edelsüss (Menge unklar)",
    "Chili (etwas, Form unklar)",
    "Kurkuma (Menge unklar)",
    "Schwarzer Pfeffer (Menge unklar)",
    "Salz (Menge unklar)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Grosse Zwiebeln bis zur Mitte einschneiden und bei schwacher Hitze kurz in heissem Wasser köcheln. Die genaue Kochzeit ist unklar."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Petersilie, Koriander, Frühlingszwiebeln und Minze fein hacken. Laut Quelle kommt auch gehackte Zwiebel in die Füllung, die Menge ist unklar."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Vegetarisch: Baumnüsse klein hacken und ca. eine halbe Stunde in Wasser einlegen. Im Video ist die Hälfte mit Fleisch und die Hälfte mit Baumnüssen gefüllt."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Kräuter mit Hackfleisch oder Baumnüssen, Reis, Gewürzen, 1½ EL Tomatenmark und Olivenöl gut vermengen. Ganz ohne Fleisch ½ EL Tomatenmark mehr nehmen."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Die Zwiebeln eine halbe Stunde in kaltes Wasser legen, dann die Schichten ablösen."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Sauce: 1½ EL Tomatenmark, 2 EL Olivenöl, Gewürze und 2 Tassen Wasser verrühren und unten in den Topf oder die Form geben."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Die Zwiebelschichten grosszügig füllen und in die Sauce legen."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Im Ofen mit Alufolie 40 Min. garen, dann ohne Folie weitere 20 Min. Die Temperatur ist unklar. Alternative laut Beschreibung: im Topf 30–40 Min. sanft köcheln lassen."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Im Video wird mit Dill garniert, abgeleitet aus dem Video; Dill steht nicht in der Zutatenliste."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/gefuellte-zwiebeln/vorrat/"
}