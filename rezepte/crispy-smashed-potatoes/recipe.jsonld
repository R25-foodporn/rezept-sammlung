{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": "Crispy Smashed Potatoes",
  "author": {
    "@type": "Person",
    "name": "Natashas Kitchen"
  },
  "description": "Zerdrückte Ofenkartoffeln mit Parmesankruste, mit Anpassung für weniger Acrylamid",
  "recipeYield": "Portionen unklar",
  "recipeIngredient": [
    "ca. 900 g Kartoffeln (Quelle: 2 lbs, 12–16 kleine, 4–5 cm Durchmesser, rot und gelb gemischt; Anpassung: mehligkochend)",
    "¾ Tasse Parmesan (gerieben, oder nach Geschmack)",
    "2 EL Petersilie (frisch, fein gehackt, zum Garnieren)"
  ],
  "recipeInstructions": [
    {
      "@type": "HowToStep",
      "position": 1,
      "text": "Kartoffeln waschen. In der Quelle kleine rote und gelbe Kartoffeln. Eigene Anpassung weniger Acrylamid, nicht aus der Quelle: mehligkochende Kartoffeln nehmen."
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "text": "Mittelgrossen Topf Wasser aufkochen, 2 TL Salz und die Kartoffeln dazugeben, bei schwacher Hitze ca. 25–30 Min. köcheln, bis sie mit der Gabel leicht durchstochen werden können."
    },
    {
      "@type": "HowToStep",
      "position": 3,
      "text": "Abgiessen. Quelle: Ofen auf 450 °F vorheizen, ca. 230 °C. Eigene Anpassung weniger Acrylamid, nicht aus der Quelle: 200 °C Ober-/Unterhitze oder max. 190 °C Umluft, Blech mit Öl im Ofen vorheizen, Kartoffeln 5–10 Min. ausdampfen lassen."
    },
    {
      "@type": "HowToStep",
      "position": 4,
      "text": "Kartoffeln mit Abstand aufs Blech legen, in der Quelle ein belegtes Blech. Mit Kartoffelstampfer oder glattem Glasboden sanft flach drücken, Quelle ca. ½ Zoll, ca. 1,3 cm, Anpassung ca. 1 cm."
    },
    {
      "@type": "HowToStep",
      "position": 5,
      "text": "Mit Olivenöl beträufeln, mit Knoblauchsalz und Pfeffer würzen. Eigene Anpassung weniger Acrylamid, nicht aus der Quelle: ca. 1 EL Olivenöl pro 500 g, Knoblauchsalz erst gegen Ende."
    },
    {
      "@type": "HowToStep",
      "position": 6,
      "text": "Quelle: ca. 15 Min. backen, bis die Unterseite goldig ist, rasch wenden, nachwürzen, mit Öl beträufeln und weitere 12–15 Min. backen, bis aussen knusprig und goldbraun. Eigene Anpassung weniger Acrylamid, nicht aus der Quelle: bei der tieferen Temperatur insgesamt 35–45 Min., nach halber Zeit wenden, nur bis goldgelb, nicht dunkelbraun."
    },
    {
      "@type": "HowToStep",
      "position": 7,
      "text": "Ca. ¾ Tasse Parmesan darüberstreuen und weitere 3 Min. backen, bis der Käse geschmolzen ist."
    },
    {
      "@type": "HowToStep",
      "position": 8,
      "text": "Mit Petersilie bestreuen und servieren. Eigene Anpassung weniger Acrylamid, nicht aus der Quelle: dunkle Stellen wegschneiden, Flockensalz erst nach dem Backen."
    },
    {
      "@type": "HowToStep",
      "position": 9,
      "text": "Tipp von Marks erstem Versuch: Nicht knusprig wegen festkochender Kartoffeln und zu früh aus dem Ofen. Hinweis Kinder: für Martin nur goldgelbe Stücke, keine dunklen Ränder."
    }
  ],
  "url": "https://r25-foodporn.github.io/rezept-sammlung/rezepte/crispy-smashed-potatoes/"
}